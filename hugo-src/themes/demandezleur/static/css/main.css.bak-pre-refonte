@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500&family=Playfair+Display:ital,wght@0,500;0,700;1,500&display=swap');

:root {
  --bg-primary: #0a0c10;
  --bleu-france: #002395;
  --blanc-france: #e8e8e8;
  --rouge-france: #ED2939;
  --text-primary: #f5f5f5;
  --text-secondary: rgba(255,255,255,0.6);
  --text-tertiary: rgba(255,255,255,0.4);
  --text-hint: rgba(255,255,255,0.2);
  --text-ghost: rgba(255,255,255,0.12);
  --text-watermark: rgba(255,255,255,0.03);
  --border-subtle: rgba(255,255,255,0.06);
  --border-light: rgba(255,255,255,0.08);
  --border-medium: rgba(255,255,255,0.12);
  --border-hover: rgba(255,255,255,0.4);
  --accent-dot: #ED2939;
  --accent-cursor: #ED2939;
  --accent-chevron: #002395;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: 'JetBrains Mono', monospace;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.tricolore { height: 3px; display: flex; flex-shrink: 0; width: 100%; }
.tricolore span:nth-child(1) { flex:1; background:var(--bleu-france); }
.tricolore span:nth-child(2) { flex:1; background:var(--blanc-france); }
.tricolore span:nth-child(3) { flex:1; background:var(--rouge-france); }

.code-watermark {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  line-height: 1.5;
  color: var(--text-watermark);
  padding: 40px 16px 16px;
  white-space: pre-wrap;
  word-break: break-all;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.main-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28px 24px 0;
  flex: 1;
  width: 100%;
}

.rf-label {
  font-family: 'Playfair Display', serif;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
  margin-bottom: 16px;
  text-align: center;
}

.lef {
  font-family: 'Playfair Display', serif;
  font-size: 10px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.6);
  margin-bottom: 24px;
  display: flex;
  gap: 16px;
}
.lef span { position: relative; }
.lef span:not(:last-child)::after {
  content: '';
  position: absolute;
  right: -9px;
  top: 50%;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: rgba(255,255,255,0.6);
}

.question-wrap {
  position: relative;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.question-halo {
  position: absolute;
  width: 100px;
  height: 100px;
  border-radius: 50%;
  border: 1px solid var(--border-subtle);
}
.question {
  font-family: 'Playfair Display', serif;
  font-size: 96px;
  font-weight: 700;
  line-height: 1;
  background: linear-gradient(180deg, var(--bleu-france) 0%, var(--text-primary) 50%, var(--rouge-france) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  position: relative;
  z-index: 1;
}

.site-title {
  font-family: 'JetBrains Mono', monospace;
  font-size: 22px;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 1px;
  margin-bottom: 4px;
  text-align: center;
}
.site-title .dot { color: var(--accent-dot); }

.subtitle {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  font-weight: 300;
  color: var(--text-tertiary);
  letter-spacing: 1.5px;
  margin-bottom: 20px;
  text-align: center;
}

.badge-2027 {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--border-medium);
  border-radius: 4px;
  padding: 8px 16px;
  margin-bottom: 24px;
}
.badge-2027 .yr {
  font-family: 'JetBrains Mono', monospace;
  font-size: 20px;
  font-weight: 500;
  color: var(--text-primary);
}
.badge-2027 .lbl {
  font-family: 'Playfair Display', serif;
  font-size: 9px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--text-tertiary);
  line-height: 1.4;
}

.actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 24px;
}

.btn {
  display: block;
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 4px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 1px;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
}
.btn-primary {
  background: var(--text-primary);
  color: var(--bg-primary);
}
.btn-secondary {
  background: transparent;
  color: var(--text-secondary);
  border: 1px solid var(--border-medium);
}

.carousel-section {
  position: relative;
  z-index: 1;
  width: 100%;
  padding: 0 24px 20px;
}

.carousel-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  color: var(--text-secondary);
  letter-spacing: 2px;
  text-transform: uppercase;
  text-align: center;
  margin-bottom: 14px;
}

.carousel-window {
  position: relative;
  overflow: hidden;
  height: 150px;
  width: 100%;
}

.carousel-track {
  display: flex;
  position: absolute;
  top: 0;
  left: 0;
  transition: transform 0.6s ease;
  width: 100%;
  height: 100%;
}

.carousel-slide {
  flex-shrink: 0;
  width: 100%;
  flex: 0 0 100%;
  display: flex;
  justify-content: center;
  gap: 8px;
  padding: 0 4px;
}

.candidate-card {
  width: 96px;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  transition: transform 0.15s ease;
  -webkit-tap-highlight-color: transparent;
  text-decoration: none;
}
.candidate-card:active {
  transform: scale(0.95);
}

.candidate-photo {
  width: 72px;
  height: 72px;
  border-radius: 4px;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'JetBrains Mono', monospace;
  font-size: 20px;
  font-weight: 500;
  color: rgba(255,255,255,0.8);
  border: 1.5px solid transparent;
  transition: border-color 0.2s;
}
.candidate-card:active .candidate-photo {
  border-color: var(--border-hover);
}

.candidate-name {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  font-weight: 500;
  color: rgba(255,255,255,0.7);
  text-align: center;
  line-height: 1.2;
}
.candidate-party {
  font-family: 'JetBrains Mono', monospace;
  font-size: 7px;
  color: rgba(255,255,255,0.25);
  text-align: center;
  letter-spacing: 0.5px;
  margin-top: 2px;
}
.candidate-cta {
  font-family: 'JetBrains Mono', monospace;
  font-size: 7px;
  color: var(--text-ghost);
  text-align: center;
  letter-spacing: 0.5px;
  margin-top: 4px;
  transition: color 0.2s;
}
.candidate-card:active .candidate-cta {
  color: var(--border-hover);
}

.carousel-dots {
  display: flex;
  justify-content: center;
  gap: 6px;
  margin-top: 10px;
}
.cdot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  cursor: pointer;
  transition: background 0.3s;
}
.cdot.active { background: rgba(255,255,255,0.5); }

.chat-preview {
  position: relative;
  z-index: 2;
  margin: 0 24px 16px;
  border: 1px solid var(--border-light);
  border-radius: 6px;
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transition: max-height 0.4s ease, opacity 0.3s ease;
}
.chat-preview.open {
  max-height: 260px;
  opacity: 1;
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px;
  background: rgba(255,255,255,0.04);
  border-bottom: 1px solid var(--border-subtle);
}
.chat-header-left {
  display: flex;
  align-items: center;
  gap: 8px;
}
.chat-avatar {
  width: 28px;
  height: 28px;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  font-weight: 500;
  color: rgba(255,255,255,0.8);
}
.chat-cname {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  font-weight: 500;
  color: rgba(255,255,255,0.7);
}
.chat-close {
  font-family: 'JetBrains Mono', monospace;
  font-size: 16px;
  color: rgba(255,255,255,0.3);
  cursor: pointer;
  padding: 4px 8px;
  border: none;
  background: none;
  line-height: 1;
}

.chat-body { padding: 14px; }
.chat-greeting {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--text-tertiary);
  line-height: 1.5;
  margin-bottom: 12px;
}
.chat-greeting strong {
  color: rgba(255,255,255,0.65);
  font-weight: 500;
}

.chat-input-row {
  display: flex;
  gap: 8px;
  align-items: center;
}
.chat-input {
  flex: 1;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 4px;
  padding: 10px 12px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: rgba(255,255,255,0.5);
  outline: none;
}
.chat-send {
  background: rgba(255,255,255,0.08);
  border: none;
  border-radius: 4px;
  padding: 10px 12px;
  cursor: pointer;
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  color: var(--text-tertiary);
}

.prompt-hint {
  position: relative;
  z-index: 1;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--text-hint);
  text-align: center;
  padding: 8px 24px 12px;
}
.prompt-hint .chev { color: var(--accent-chevron); }
.prompt-hint .blink {
  display: inline-block;
  width: 1px;
  height: 12px;
  background: var(--accent-cursor);
  margin-left: 3px;
  vertical-align: middle;
  animation: blink 1s step-end infinite;
}
@keyframes blink { 50% { opacity: 0; } }

/* Grille candidats pour la page list */
.candidats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  padding: 24px;
  width: 100%;
}

/* Navbar */
.site-header {
  position: sticky;
  top: 0;
  background: var(--bg-primary);
  border-bottom: 1px solid var(--border-light);
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  z-index: 100;
}
.header-logo {
  font-family: 'JetBrains Mono', monospace;
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary);
  text-decoration: none;
}
.header-logo .dot { color: var(--accent-dot); }
.header-menu-btn {
  background: none;
  border: none;
  color: var(--text-primary);
  font-size: 20px;
  cursor: pointer;
}

@media (min-width: 768px) {
  .question { font-size: 140px; }
  .question-halo { width: 130px; height: 130px; }
  .site-title { font-size: 32px; }
  .actions { flex-direction: row; gap: 12px; }
  .actions .btn { width: auto; flex: 1; }
  .carousel-slide { gap: 16px; }
  .candidate-photo { width: 96px; height: 96px; font-size: 24px; }
  .candidats-grid { grid-template-columns: repeat(3, 1fr); }
  .main-content { max-width: 800px; margin: 0 auto; }
  .carousel-section { max-width: 800px; margin: 0 auto; }
}

@media (min-width: 1024px) {
  .candidats-grid { grid-template-columns: repeat(4, 1fr); }
}
/* ============================================================================
   Rate Limit Blocage
   ============================================================================ */
.rate-limit-blocage {
    max-width: 600px;
    margin: 40px auto;
    padding: 32px;
    border: 1px solid var(--border-medium);
    border-left: 3px solid var(--rouge-france);
    border-radius: 4px;
    background: rgba(255,255,255,0.02);
    font-family: 'JetBrains Mono', monospace;
}

.rate-limit-blocage h3 {
    color: var(--text-primary);
    font-size: 18px;
    margin: 0 0 16px 0;
    font-weight: 500;
}

.rate-limit-blocage p {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 12px 0;
}

.rate-limit-blocage .limite-info {
    font-size: 12px;
    color: var(--text-tertiary);
    margin: 16px 0;
}

.rate-limit-blocage .rate-limit-soutien {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
}

.rate-limit-blocage .petit {
    font-size: 12px;
    color: var(--text-tertiary);
    line-height: 1.5;
}

.rate-limit-blocage a {
    color: var(--rouge-france);
    text-decoration: underline;
}

.rate-limit-blocage button {
    margin-top: 20px;
}

/* ============================================================================
   Footer
   ============================================================================ */
.site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 40px 20px;
    margin-top: 60px;
    border-top: 1px solid var(--border-subtle);
}

.footer-mentions {
    font-size: 9px;
    color: var(--text-tertiary);
    text-align: center;
    max-width: 600px;
    line-height: 1.4;
}

.footer-nav {
    display: flex;
    align-items: center;
    gap: 0;
    font-size: 11px;
    color: var(--text-tertiary);
}

.footer-nav a, .footer-nav .no-track {
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color 0.2s ease;
}

.footer-nav a:hover {
    color: var(--rouge-france);
    text-decoration: underline;
}

.footer-nav .sep {
    margin: 0 8px;
    color: var(--border-medium);
    opacity: 0.5;
}
